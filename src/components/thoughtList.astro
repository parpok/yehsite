---
import { getCollection, getEntry } from "astro:content";

const thoughts = (await getCollection("thoughts"))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 5);
---

<div class="vstack thoughtList">
    <h1>Thoughts (made while disassociated)</h1>
    <!--  list couple recents -->
    <ul>
        {
            thoughts.map((thought) => (
                <li>
                    <a href=`./thoughts/${thought.data.id}`>{thought.data.title}</a>
                </li>
            ))
        }
    </ul>
    <a href="/thoughts">See all thoughts</a>
</div>

<style>
    .thoughtList {
        border-style: solid;
        padding: 25px;
    }
</style>
