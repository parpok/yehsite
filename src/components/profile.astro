        <!-- </div> -->
        <!-- <div class="otherBadges"> -->
        <Image
            src="/badges/other/madewith_macos.gif"
            alt="Made with MacOS"
            width="88"
            height="31"
        />
    </div>
</div>

<style>
    .profile {
        justify-content: space-around;
        gap: 15px;
        padding: 25px;
        border-style: dotted;
    }

    .pfp {
        border-radius: 25%;
        border-style: dotted;
    }

    .socialsList {
        display: flex;
        justify-content: space-around;
    }
</style>
